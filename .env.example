# Cloudflare R2 credentials for weekly_update.py upload step.
# Copy this file to `.env` (which is gitignored) and fill in the real values.
#
# Where to find these values:
#   R2_ACCOUNT_ID:        Cloudflare dashboard -> R2 -> Overview (top right "Account ID")
#   R2_ACCESS_KEY_ID:     Created when you generate an R2 API token
#   R2_SECRET_ACCESS_KEY: Created when you generate an R2 API token
#                         (shown ONCE at creation time -- save it immediately)
#
# Token creation:
#   Cloudflare dashboard -> R2 -> Manage R2 API Tokens -> Create API Token
#     - Permissions: "Object Read & Write"
#     - Specify bucket: nala-data  (or whichever bucket you target)
#     - TTL: leave blank for non-expiring, or set a duration

R2_ACCOUNT_ID=your-account-id-here
R2_ACCESS_KEY_ID=your-access-key-id-here
R2_SECRET_ACCESS_KEY=your-secret-access-key-here

# Optional overrides (defaults shown):
# R2_BUCKET=nala-data
# R2_OBJECT_KEY=nala_rd_data.db
